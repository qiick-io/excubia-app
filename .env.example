APP_NAME=Excubia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Reverse proxies trusted for X-Forwarded-* (IPs or CIDR ranges, comma-separated, or *), e.g. a TLS proxy in front of Docker
# TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial super-admin created by `php artisan db:seed`. Change the password.
INITIAL_SUPER_ADMIN_FIRST_NAME=Super
INITIAL_SUPER_ADMIN_LAST_NAME=Admin
INITIAL_SUPER_ADMIN_EMAIL=superadmin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=password

# OIDC SSO is configured in Settings → Application. Redirect URI: {APP_URL}/auth/oidc/callback
# Docker testing only:
# OIDC_DISCOVERY_BASE=http://keycloak:8080/realms/excubia
# OIDC_SERVER_ORIGIN=http://keycloak:8080
# OIDC_ALLOW_PRIVATE_HOSTS=false

# AI assistant (#17): off by default. Ollama by default; a cloud provider is an explicit opt-in (config/ai.php).
EXCUBIA_AI_ENABLED=false
# AI_DEFAULT_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
# LM Studio or another OpenAI-compatible local server:
# AI_DEFAULT_PROVIDER=local
# LOCAL_AI_URL=http://127.0.0.1:1234/v1
# LOCAL_AI_MODEL=openai/gpt-oss-20b

# Runtime aggregates and exception groups kept (days)
EXCUBIA_RUNTIME_RETENTION_DAYS=14
EXCUBIA_EXCEPTIONS_RETENTION_DAYS=90

# Record this install's own runtime and exceptions on the system project (#84)
EXCUBIA_SELF_MONITORING=true

# Alerts (#22): the same event, project and subject at most once per this many minutes (0: off);
# push.rejected after this many token rejections within an hour
EXCUBIA_ALERT_THROTTLE_MINUTES=60
EXCUBIA_PUSH_REJECTED_ALERT_AFTER=10

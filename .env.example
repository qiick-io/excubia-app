APP_NAME=Excubia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Reverse proxies trusted for X-Forwarded-* (IPs or CIDR ranges, comma-separated, or *), e.g. a TLS proxy in front of Docker
# TRUSTED_PROXIES=
# Strict-Transport-Security max-age (seconds) on https requests; 0 sends none (set HSTS on the proxy instead)
# EXCUBIA_HSTS_MAX_AGE=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Development super-admin created by `php artisan db:seed` in local and testing only, and only when
# the password is set. Servers create the first admin at /setup (or `php artisan excubia:create-user`).
INITIAL_SUPER_ADMIN_FIRST_NAME=Super
INITIAL_SUPER_ADMIN_LAST_NAME=Admin
INITIAL_SUPER_ADMIN_EMAIL=superadmin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=

# OIDC SSO is configured in Settings → Application. Redirect URI: {APP_URL}/auth/oidc/callback
# Docker testing only:
# OIDC_DISCOVERY_BASE=http://keycloak:8080/realms/excubia
# OIDC_SERVER_ORIGIN=http://keycloak:8080
# OIDC_ALLOW_PRIVATE_HOSTS=false

# AI assistant (#17): off by default. Ollama by default; a cloud provider is an explicit opt-in (config/ai.php).
EXCUBIA_AI_ENABLED=false
# AI_DEFAULT_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
# LM Studio or another OpenAI-compatible local server:
# AI_DEFAULT_PROVIDER=local
# LOCAL_AI_URL=http://127.0.0.1:1234/v1
# LOCAL_AI_MODEL=openai/gpt-oss-20b

# Runtime aggregates and exception groups kept (days)
EXCUBIA_RUNTIME_RETENTION_DAYS=14
# Hours of per-minute runtime rows and exception occurrences; older minutes are folded into hourly rows (at least 24)
EXCUBIA_RUNTIME_MINUTE_HOURS=48
EXCUBIA_EXCEPTIONS_RETENTION_DAYS=90
# Days of exception occurrences for the charts (at least 14); groups keep their totals for the retention above
EXCUBIA_EXCEPTION_OCCURRENCE_DAYS=14

# Days of checks with always the same value before a Pennant feature counts as a stale flag (#189)
EXCUBIA_PENNANT_STALE_AFTER_DAYS=30

# Record this install's own runtime and exceptions on the system project (#84)
EXCUBIA_SELF_MONITORING=true
# Its runtime types (#219), comma-separated excubia.json keys (requests,queueWait,server,health) or all;
# empty: every type the installed excubia-core supports, cache sampled
EXCUBIA_SELF_MONITORING_TYPES=

# Alerts (#22): the same event, project and subject at most once per this many minutes (0: off);
# push.rejected after this many token rejections within an hour
EXCUBIA_ALERT_THROTTLE_MINUTES=60
EXCUBIA_PUSH_REJECTED_ALERT_AFTER=10
# eol.approaching this many days before PHP, Laravel or Node security support ends (#157)
EXCUBIA_EOL_ALERT_DAYS=90,30,7

        "@laravel/passkeys": "^0.2.0",
        "@tailwindcss/vite": "^4.3.4",
        "@tanstack/react-table": "^8.21.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",

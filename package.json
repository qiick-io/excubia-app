{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "knip": "knip",
        "lint": "vp check && node scripts/check-ui-tokens.mjs",
        "lint:i18n": "oxlint -c .oxlintrc.i18n.json -A all -f json resources/js | node scripts/qiick-ratchet.mjs lint --rule i18next/no-literal-string --baseline i18n-literal-baseline.json",
        "lint:legacy": "node scripts/check-legacy-web.mjs resources/js",
        "lint:standards": "oxlint -c .oxlintrc.standards.json -f json resources/js | node scripts/qiick-ratchet.mjs lint --rule eslint/no-restricted-imports,eslint/no-restricted-properties,eslint/id-length,eslint/max-lines,eslint/max-lines-per-function --baseline qiick-lint-baseline.json",
        "types": "tsc --noEmit",
        "lint:ui-tokens": "node scripts/check-ui-tokens.mjs",
        "test": "node --experimental-strip-types --test scripts/upgrade-plan.test.mjs"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@inertiajs/react": "^3.11.0",
        "@laravel/passkeys": "^0.4.1",
        "@tanstack/react-table": "^8.21.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "concurrently": "^10.0.7",
        "i18next": "^26.7.2",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.75.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.3",
        "recharts": "^3.11.0",
        "sonner": "^2.0.8",
        "sortablejs": "^1.15.7",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.11.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@rolldown/plugin-babel": "^0.3.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^22.20.5",
        "@types/sortablejs": "^1.15.9",
        "@vitejs/plugin-react": "^6.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint-plugin-i18next": "^6.1.5",
        "knip": "^6.45.1",
        "laravel-vite-plugin": "^3.2.1",
        "playwright": "^1.65.1",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
        "vite-plus": "1.6.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@rollup/rollup-linux-x64-gnu": "4.68.6",
        "@rollup/rollup-win32-x64-msvc": "4.68.6",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.5",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.5",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
    },
    "engines": {
        "node": "26.x"
    }
}

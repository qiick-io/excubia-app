{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "knip": "knip",
        "lint": "vp check && node scripts/check-ui-tokens.mjs",
        "lint:i18n": "oxlint -c .oxlintrc.i18n.json -A all -f json resources/js | node scripts/qiick-ratchet.mjs lint --rule i18next/no-literal-string --baseline i18n-literal-baseline.json",
        "types": "tsc --noEmit",
        "lint:ui-tokens": "node scripts/check-ui-tokens.mjs",
        "a11y:contrast": "node scripts/a11y-contrast.mjs"
    },

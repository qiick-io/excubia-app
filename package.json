        "radix-ui": "^1.8.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-i18next": "^17.0.15",
        "recharts": "^3.10.1",
        "sonner": "^2.0.0",
        "sortablejs": "^1.15.7",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vaul": "^1.1.2",

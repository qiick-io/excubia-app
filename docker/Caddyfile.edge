# Set EXCUBIA_HOST to the public DNS name and EXCUBIA_UPSTREAM to the private origin address.
http://{$EXCUBIA_HOST} {
	@browser {
		method GET HEAD
		not path /api /api/* /mcp /mcp/* /health /health/* /up /up/* /auth/oidc/backchannel-logout /auth/oidc/backchannel-logout/*
	}
	route {
		redir @browser https://{$EXCUBIA_HOST}{uri} 308
		respond "HTTPS required" 400
	}
}

{$EXCUBIA_HOST} {
	tls {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}
	reverse_proxy {$EXCUBIA_UPSTREAM}
}

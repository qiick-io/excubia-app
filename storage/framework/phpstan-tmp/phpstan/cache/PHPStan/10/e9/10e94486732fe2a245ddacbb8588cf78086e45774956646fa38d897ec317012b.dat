 * Bounds the runtime and exception data: runtime aggregates (hourly rows past the per-minute
 * window, #212), their hourly rollups (#137) and scheduled-task runs (#110) older than the runtime
 * retention, exception groups not seen within the exceptions retention (#113), the occurrences
 * older than the shorter of the occurrence window and that retention (#214: the charts and "In
 * range" counts reach back 14 days at most, while a group keeps its own total, first and last
 * seen and releases), the batch ids older than BATCH_ID_DAYS, the alert history (#114) older than
 * the longer of the two retentions, the mutes that ended, and the
 * push rejection counters (#117) older than two days. The daily AI usage (#129) is kept for the
 * longer of the runtime retention and AI_USAGE_DAYS, so the monthly budget and the digest see
 * the current and the previous month.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:64;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:3:{s:13:"AI_USAGE_DAYS";a:12:{s:18:"declaringClassName";s:32:"App\Actions\PruneTelemetryAction";s:21:"implementingClassName";s:32:"App\Actions\PruneTelemetryAction";s:4:"name";s:13:"AI_USAGE_DAYS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"62";s:10:"attributes";a:6:{s:9:"startLine";i:34;s:7:"endLine";i:34;s:13:"startTokenPos";i:88;s:12:"startFilePos";i:1432;s:11:"endTokenPos";i:88;s:10:"endFilePos";i:1433;}}s:10:"docComment";s:77:"/** Days of daily AI usage kept at least: this month and the previous one. */";s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:34;s:11:"startColumn";i:5;s:9:"endColumn";i:36;}s:13:"BATCH_ID_DAYS";a:12:{s:18:"declaringClassName";s:32:"App\Actions\PruneTelemetryAction";s:21:"implementingClassName";s:32:"App\Actions\PruneTelemetryAction";s:4:"name";s:13:"BATCH_ID_DAYS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"14";s:10:"attributes";a:6:{s:9:"startLine";i:41;s:7:"endLine";i:41;s:13:"startTokenPos";i:101;s:12:"startFilePos";i:1758;s:11:"endTokenPos";i:101;s:10:"endFilePos";i:1759;}}s:10:"docComment";s:267:"/**

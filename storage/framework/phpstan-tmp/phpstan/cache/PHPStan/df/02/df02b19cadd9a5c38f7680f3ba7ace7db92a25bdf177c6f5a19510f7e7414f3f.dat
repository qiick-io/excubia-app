O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-2f535b10c2e9374dccca397e66a0efdc4b4b4a13db4c839a826d2a1e418f5ca7-8.4.27-6.75.0.4";s:4:"data";a:24:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:8:"filename";s:168:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/vendor/composer/../qiick/excubia-core/src/Enums/RuntimeTypeEnum.php";}}s:9:"namespace";s:19:"Qiick\Excubia\Enums";s:4:"name";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:9:"shortName";s:15:"RuntimeTypeEnum";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:1;s:12:"isBackedEnum";b:1;s:9:"modifiers";i:0;s:10:"docComment";s:1651:"/**
 * The kinds of runtime aggregate the Laravel collector records
 * (`docs/runtime-schema.json`). Each one is a separate opt-in under the
 * `runtime` key of `excubia.json`; the value is the `type` of an aggregate.
 *
 * The five types of 1.0.0-beta.1 are on by default once `runtime.enabled`
 * is true. The types added in 1.0.0-beta.2 (#132, #133) and later
 * (`duplicateQuery`, #148, `server`, #149, `command`, #152, `health`, #188,
 * `ai` and `aiTool`, #198, `octane`, #213, `reverb`, #215,
 * `billingWebhook`, #217, `auth`, #219, `scout`, #221, `pennant`, #225) are off by default, so an excubia-app that does
 * not know them yet never receives them. `ai` and `aiTool` also need the
 * Laravel AI SDK (`laravel/ai`) installed, `octane` needs Laravel Octane
 * (`laravel/octane`), `reverb` Laravel Reverb (`laravel/reverb`) and
 * `billingWebhook` Laravel Cashier (`laravel/cashier` or
 * `laravel/cashier-paddle`), `scout` Laravel Scout (`laravel/scout`) and
 * `pennant` Laravel Pennant (`laravel/pennant`); without them they record
 * nothing.
 *
 * `server` is not an event type: `excubia:push-runtime` takes one sample
 * of the machine per run (ServerMetricsService). Neither is `health` (#188):
 * each run, at most once a minute, runs the fast local Artisan checks and
 * appends one aggregate per check (HealthSampleService).
 *
 * The duration types (`request`, `slowQuery`, `job`, `scheduledTask`,
 * `outgoingHttp`, `queueWait`, `command`, `ai`, `aiTool`, `billingWebhook`, and the index operations of `scout`) also carry a latency `histogram` (#147) with
 * the bucket bounds below, a public contract (`docs/CONTRACTS.md`).
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:131;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:19:"HISTOGRAM_BOUNDS_MS";a:12:{s:18:"declaringClassName";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:21:"implementingClassName";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:4:"name";s:19:"HISTOGRAM_BOUNDS_MS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:55:"[5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000]";s:10:"attributes";a:6:{s:9:"startLine";i:43;s:7:"endLine";i:43;s:13:"startTokenPos";i:36;s:12:"startFilePos";i:2166;s:11:"endTokenPos";i:68;s:10:"endFilePos";i:2220;}}s:10:"docComment";s:350:"/**
 * Upper bounds, in milliseconds and inclusive, of the latency histogram
 * buckets (#147). The histogram has one more bucket for durations above
 * the last bound, so it holds `count(HISTOGRAM_BOUNDS_MS) + 1` counts.
 * Fixed and the same for every type, so histograms always add up
 * element by element; changing them is a contract change.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:43;s:11:"startColumn";i:5;s:9:"endColumn";i:95;}}s:19:"immediateProperties";a:2:{s:4:"name";a:16:{s:18:"declaringClassName";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:21:"implementingClassName";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:4:"name";s:4:"name";s:9:"modifiers";i:2177;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";N;s:7:"endLine";N;s:11:"startColumn";i:-1;s:9:"endColumn";i:-1;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"value";a:16:{s:18:"declaringClassName";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:21:"implementingClassName";s:35:"Qiick\Excubia\Enums\RuntimeTypeEnum";s:4:"name";s:5:"value";s:9:"modifiers";i:2177;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";N;s:7:"endLine";N;s:11:"startColumn";i:-1;s:9:"endColumn";i:-1;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:6:{s:16:"configurationKey";a:20:{s:4:"name";s:16:"configurationKey";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:74:"/**

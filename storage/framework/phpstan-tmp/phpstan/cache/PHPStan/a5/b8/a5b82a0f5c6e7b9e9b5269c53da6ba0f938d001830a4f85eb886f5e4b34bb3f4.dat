O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-2905b241758f5a3d4932d14e48c70e70ab03ff13531aa09a95b6cba4489a5688";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:35:"App\Traits\BuildsPerIndexRulesTrait";s:8:"filename";s:140:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/app/Traits/BuildsPerIndexRulesTrait.php";}}s:9:"namespace";s:10:"App\Traits";s:4:"name";s:35:"App\Traits\BuildsPerIndexRulesTrait";s:9:"shortName";s:24:"BuildsPerIndexRulesTrait";s:11:"isInterface";b:0;s:7:"isTrait";b:1;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:852:"/**
 * Builds the rules of the pushed lists (`report.checks`, `exceptions.groups`) per index, as
 * `/api/runtime` does since #195 (#238). The validator expands a wildcard rule over the whole
 * flattened subtree it covers, so unknown fields a later excubia-core nests inside a check or a
 * group (core 1.1 may add any) were walked once per rule: about 0.4 s for 1 MB.
 *
 * The expansion yields the keys the wildcard would, in the same order (rule by rule, then index
 * by index), and names them in messages as the validator names a wildcard's keys (raw, not
 * `first seen`), so what is rejected, the error keys and the messages stay the same. The caller
 * puts the expanded rules last, where the validator appends a wildcard's keys. An array whose
 * keys hold a dot keeps its wildcard, which the validator then expands over that array alone.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:19;s:7:"endLine";i:94;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:18:"perIndexAttributes";a:16:{s:18:"declaringClassName";s:35:"App\Traits\BuildsPerIndexRulesTrait";s:21:"implementingClassName";s:35:"App\Traits\BuildsPerIndexRulesTrait";s:4:"name";s:18:"perIndexAttributes";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default";a:2:{s:4:"code";s:2:"[]";s:10:"attributes";a:6:{s:9:"startLine";i:22;s:7:"endLine";i:22;s:13:"startTokenPos";i:33;s:12:"startFilePos";i:1064;s:11:"endTokenPos";i:34;s:10:"endFilePos";i:1065;}}s:10:"docComment";s:77:"/** @var array<string, string> the expanded keys, each displayed as itself */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:22;s:11:"startColumn";i:5;s:9:"endColumn";i:43;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:3:{s:10:"attributes";a:20:{s:4:"name";s:10:"attributes";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:132:"/**

O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-a154808bdcf771a480850bbb51c0eacc81d90e80d4b4f4526ebf971510e8b5d9";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:48:"App\Actions\DownsampleExceptionOccurrencesAction";s:8:"filename";s:153:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/app/Actions/DownsampleExceptionOccurrencesAction.php";}}s:9:"namespace";s:11:"App\Actions";s:4:"name";s:48:"App\Actions\DownsampleExceptionOccurrencesAction";s:9:"shortName";s:36:"DownsampleExceptionOccurrencesAction";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1167:"/**
 * Folds the exception occurrences older than the per-minute window into hourly rows (#214), as
 * DownsampleRuntimeAction does for the runtime minutes (#212): a group's latest minute of the
 * hour absorbs the counts of its other minutes, which are deleted.
 *
 * The readers stay unchanged and give the same numbers: the Exceptions tab's "In range" count
 * and each group's chart sum the occurrences of their window or bucket, and every window and
 * bucket that reaches past the per-minute window (at least 24 hours) starts on a whole hour. The
 * group row keeps its own total, first and last seen and releases, which the digest and the
 * overview read; this fold never touches it.
 *
 * Idempotent and safe to re-run, with the same window as the runtime fold: from the previous
 * run's end minus DownsampleRuntimeAction::LOOKBACK_HOURS (for late pushes and missed runs), or
 * from the oldest stored minute without that mark, up to the whole hour before the cutoff. Each
 * group-hour is one transaction that first locks the group row, as the ingest does
 * (StorePushedExceptionsAction), so a concurrent push lands either before the fold or after it.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:107;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:16:"FOLDED_UNTIL_KEY";a:12:{s:18:"declaringClassName";s:48:"App\Actions\DownsampleExceptionOccurrencesAction";s:21:"implementingClassName";s:48:"App\Actions\DownsampleExceptionOccurrencesAction";s:4:"name";s:16:"FOLDED_UNTIL_KEY";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:44:"'excubia.exception_occurrences_folded_until'";s:10:"attributes";a:6:{s:9:"startLine";i:33;s:7:"endLine";i:33;s:13:"startTokenPos";i:58;s:12:"startFilePos";i:1551;s:11:"endTokenPos";i:58;s:10:"endFilePos";i:1594;}}s:10:"docComment";s:71:"/** The cache key of the hour the last run folded up to (Unix time). */";s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:5;s:9:"endColumn";i:81;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:3:{s:7:"execute";a:20:{s:4:"name";s:7:"execute";s:10:"parameters";a:1:{s:6:"before";a:14:{s:4:"name";s:6:"before";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:22:"Carbon\CarbonImmutable";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:39;s:11:"startColumn";i:29;s:9:"endColumn";i:51;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:154:"/**

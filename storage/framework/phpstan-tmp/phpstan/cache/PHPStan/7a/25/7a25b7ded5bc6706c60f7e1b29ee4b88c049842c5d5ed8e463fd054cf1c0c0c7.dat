O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-f465a6b2b1ca7d54b3fd2bd5f737d0fe086a206866fc70d3f4595fb593792f96";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:39:"Database\Seeders\CreateSuperAdminSeeder";s:8:"filename";s:144:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/database/seeders/CreateSuperAdminSeeder.php";}}s:9:"namespace";s:16:"Database\Seeders";s:4:"name";s:39:"Database\Seeders\CreateSuperAdminSeeder";s:9:"shortName";s:22:"CreateSuperAdminSeeder";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:585:"/**
 * Creates a development super-admin from config/super_admin.php, so `migrate --seed` gives a
 * local checkout a login.
 *
 * Only in `local` and `testing`, and only with a password set in `.env` (#225): a server that
 * runs the Laravel reflex `migrate --seed --force` must never get a known-credential account,
 * and `/setup` stays closed once any user exists. Servers create the first admin through
 * `/setup` or `excubia:create-user`.
 *
 * Idempotent on the email: an existing user keeps their password and gets the role,
 * the verified email and the active flag back.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:23;s:7:"endLine";i:55;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:26:"Illuminate\Database\Seeder";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:12:"ENVIRONMENTS";a:12:{s:18:"declaringClassName";s:39:"Database\Seeders\CreateSuperAdminSeeder";s:21:"implementingClassName";s:39:"Database\Seeders\CreateSuperAdminSeeder";s:4:"name";s:12:"ENVIRONMENTS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:20:"['local', 'testing']";s:10:"attributes";a:6:{s:9:"startLine";i:26;s:7:"endLine";i:26;s:13:"startTokenPos";i:52;s:12:"startFilePos";i:883;s:11:"endTokenPos";i:57;s:10:"endFilePos";i:902;}}s:10:"docComment";s:74:"/** The environments where a seeded login is a convenience, not a risk. */";s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:26;s:11:"startColumn";i:5;s:9:"endColumn";i:53;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:3:"run";a:20:{s:4:"name";s:3:"run";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:28;s:7:"endLine";i:54;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:16:"Database\Seeders";s:18:"declaringClassName";s:39:"Database\Seeders\CreateSuperAdminSeeder";s:21:"implementingClassName";s:39:"Database\Seeders\CreateSuperAdminSeeder";s:16:"currentClassName";s:39:"Database\Seeders\CreateSuperAdminSeeder";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}
 * Type-specific metrics beyond count, errorCount, totalMs and maxMs, with how two entries of
 * the same series merge: `sum` adds up (null only when both are null, so the `ai` usage
 * counts stay null when no entry reported them), `max` keeps the larger value (null only when both are
 * null), `or` is true when either is true (missing counts as false); for health (#115)
 * `status` keeps the worst of HEALTH_STATUSES, `severity` the most serious and `union` the
 * sorted union of both lists, cut to HEALTH_FINGERPRINTS.
 *
 * @return array<string, 'sum'|'max'|'or'|'status'|'severity'|'union'>
 */";s:9:"startLine";i:193;s:7:"endLine";i:210;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:9:"App\Enums";s:18:"declaringClassName";s:25:"App\Enums\RuntimeTypeEnum";s:21:"implementingClassName";s:25:"App\Enums\RuntimeTypeEnum";s:16:"currentClassName";s:25:"App\Enums\RuntimeTypeEnum";s:9:"aliasName";N;}s:12:"mergeMetrics";a:20:{s:4:"name";s:12:"mergeMetrics";s:10:"parameters";a:2:{s:4:"left";a:14:{s:4:"name";s:4:"left";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:222;s:7:"endLine";i:222;s:11:"startColumn";i:34;s:9:"endColumn";i:44;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:5:"right";a:14:{s:4:"name";s:5:"right";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:222;s:7:"endLine";i:222;s:11:"startColumn";i:47;s:9:"endColumn";i:58;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:415:"/**
 * Merges two entries' type-specific metrics by the rules of metrics(): `sum` adds up, `max`
 * keeps the larger number, both null only when neither side has a number; `or` is true when
 * either side is true; `status`, `severity` and `union` as described there (a missing side
 * is ignored).
 *
 * @param  array<string, mixed>  $left

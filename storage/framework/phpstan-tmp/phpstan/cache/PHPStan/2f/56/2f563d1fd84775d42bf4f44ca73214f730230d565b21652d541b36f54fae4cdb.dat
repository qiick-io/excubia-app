O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-eefb3b1e75dee5b67fcdf9dba7987c2b85889a7208a661b7a2627418b70f835b-8.4.27-6.75.0.4";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:8:"filename";s:178:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/vendor/composer/../qiick/excubia-core/src/Laravel/ExceptionPayloadService.php";}}s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:4:"name";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:9:"shortName";s:23:"ExceptionPayloadService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:752:"/**
 * Turns a captured exception into one exception group of
 * `docs/exception-schema.json`, and merges groups. Pure functions: nothing
 * here touches the container, the buffer or the network.
 *
 * Masking (D17) runs before anything is written to the buffer: the message
 * is scrubbed, stack frames keep only a project-relative file, a line and a
 * `Class::method` name (never arguments or local variables), and absolute
 * paths become relative to the project (or a bare file name outside it).
 *
 * Fingerprint: sha256 of the exception class and the in-app frames as
 * `file|function` lines, without line numbers, so an edit that only moves
 * code keeps the group. Vendor frames are ignored; with no in-app frame the
 * top frame is used.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:330;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:5:{s:18:"MAX_MESSAGE_LENGTH";a:12:{s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:4:"name";s:18:"MAX_MESSAGE_LENGTH";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4:"1000";s:10:"attributes";a:6:{s:9:"startLine";i:27;s:7:"endLine";i:27;s:13:"startTokenPos";i:43;s:12:"startFilePos";i:952;s:11:"endTokenPos";i:43;s:10:"endFilePos";i:955;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:5;s:9:"endColumn";i:43;}s:10:"MAX_FRAMES";a:12:{s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:4:"name";s:10:"MAX_FRAMES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"50";s:10:"attributes";a:6:{s:9:"startLine";i:29;s:7:"endLine";i:29;s:13:"startTokenPos";i:54;s:12:"startFilePos";i:989;s:11:"endTokenPos";i:54;s:10:"endFilePos";i:990;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:29;s:11:"startColumn";i:5;s:9:"endColumn";i:33;}s:12:"MAX_PREVIOUS";a:12:{s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:4:"name";s:12:"MAX_PREVIOUS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"5";s:10:"attributes";a:6:{s:9:"startLine";i:31;s:7:"endLine";i:31;s:13:"startTokenPos";i:65;s:12:"startFilePos";i:1026;s:11:"endTokenPos";i:65;s:10:"endFilePos";i:1026;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:5;s:9:"endColumn";i:34;}s:6:"MASKED";a:12:{s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:4:"name";s:6:"MASKED";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:10:"'[masked]'";s:10:"attributes";a:6:{s:9:"startLine";i:33;s:7:"endLine";i:33;s:13:"startTokenPos";i:76;s:12:"startFilePos";i:1056;s:11:"endTokenPos";i:76;s:10:"endFilePos";i:1065;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}s:5:"MASKS";a:12:{s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\ExceptionPayloadService";s:4:"name";s:5:"MASKS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2214:"[
    // Database connection details that Laravel appends to query errors.
    '/\b(Host|Socket|Database|Port): [^,)]*/' => '$1: [masked]',
    '/\beyJ[\w-]+\.[\w-]+\.[\w-]*/' => '[jwt]',
    '/\b(Bearer|Basic)\s+[^\s,;\'"]+/i' => '$1 [token]',
    // Any other scheme after an Authorization header (`Token`, `Digest`, `AWS4-HMAC-SHA256 …`): masked whole, to the closing quote or the end of the line.
    '/\b((?:Proxy-)?Authorization["\']?\s*+(?:=>|[:=])\s*+)(?:(["\'])(?!(?:Bearer|Basic)\s|\[)[^\n"\']*\2?|(?!(?:Bearer|Basic)\s|\[)[^\n]+)/i' => '$1$2[masked]$2',
    // Host names in error phrases (`Could not resolve host: db.internal`, `getaddrinfo for db.internal`).
    '/\b(resolve host\s*:?\s*|host(?:name)?\s*[:=]\s*|getaddrinfo for\s+)(["\']?)[a-z0-9][\w-]*(?:\.[\w-]+)*/i' => '$1$2[host]',
    // `key=value`, `key: value` and `'key' => 'value'`; a quoted value is masked whole, spaces included.
    '/\b([\w-]*(?:pass|pwd|secret|token|api[_-]?key|access[_-]?key|private[_-]?key|auth|signature|credentials?|cookie|session|dsn)[\w-]*)(["\']?\s*(?:=>|[=:])\s*)(?:(["\'])(?![\[?])[^"\'\n]*\3?|(?!(?:Bearer|Basic)\b|\[|\?|>)[^\s"\',;&)]+)/i' => '$1$2$3[masked]$3',
    '/[\w.%+-]+@[\w-]+(?:\.[\w-]+)+/' => '[email]',
    '/(?<![\d.])(?:\d{1,3}\.){3}\d{1,3}(?![\d.])/' => '[ip]',
    '/(?<![\w:])(?:(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|(?:[0-9a-f]{1,4}:){0,6}[0-9a-f]{0,4}::(?:[0-9a-f]{1,4}:){0,6}[0-9a-f]{0,4})(?![\w:(])/i' => '[ip]',
    '/\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/i' => '[uuid]',
    '/\b[0-9a-f]{32,}\b/i' => '[token]',
    // API-key-like: 20+ letters and digits mixed (Stripe, AWS, GitHub, base64 segments).
    '/(?<![\w+-])(?=[\w+-]*\d)(?=[\w+-]*[a-z])[\w+-]{20,}={0,2}(?![\w+=-])/i' => '[token]',
    // Phone-like: `+` and 8 or more digits with separators; US social security numbers.
    '/(?<![\w+])\+\d(?:[ .()-]*\d){7,}/' => '[number]',
    '/(?<![\w-])\d{3}-\d{2}-\d{4}(?![\w-])/' => '[number]',
    // Card-like: 13 to 19 digits, optionally grouped by spaces or dashes.
    '/(?<!\d)(?:\d[ -]?){12,18}\d(?!\d)/' => '[number]',
    // Any other number longer than four digits (ids, phone numbers, amounts).
    '/(?<!SQLSTATE\[)\d{5,}/' => '[number]',
]";s:10:"attributes";a:6:{s:9:"startLine";i:41;s:7:"endLine";i:66;s:13:"startTokenPos";i:89;s:12:"startFilePos";i:1278;s:11:"endTokenPos";i:219;s:10:"endFilePos";i:3591;}}s:10:"docComment";s:158:"/**

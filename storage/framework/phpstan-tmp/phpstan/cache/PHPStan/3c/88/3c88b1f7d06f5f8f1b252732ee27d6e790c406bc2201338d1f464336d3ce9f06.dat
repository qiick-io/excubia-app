O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-55f2a18aedc48a7cd0de36a1763580539b844077713ebefb7d260c536bfb3908";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:35:"App\Actions\DownsampleRuntimeAction";s:8:"filename";s:140:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/app/Actions/DownsampleRuntimeAction.php";}}s:9:"namespace";s:11:"App\Actions";s:4:"name";s:35:"App\Actions\DownsampleRuntimeAction";s:9:"shortName";s:23:"DownsampleRuntimeAction";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1697:"/**
 * Folds the runtime minutes older than the per-minute window into hourly rows (#212), so a busy
 * project keeps about one row per series and hour instead of sixty and the disk stays small over
 * the whole runtime retention.
 *
 * The hourly row stays in `runtime_aggregates`, in the same series (type, sample rate, dimension
 * key with release): the series' latest minute of the hour absorbs the others, which are deleted.
 * Every reader keeps working unchanged, because each one sums, maxes or merges the rows of its
 * window and every window or chart bucket that reaches past the per-minute window starts on a
 * whole hour (24 h, 7 d and 14 d buckets, UTC days): the totals, histograms, percentiles, charts
 * and `lastAt` are the same before and after the fold. The merge follows the reads, not the
 * ingest merge: counts, errors and durations add up and maxima keep the larger value, with null
 * only when every minute is null; metrics merge by RuntimeTypeEnum::mergeMetrics (sums, maxima,
 * server gauges by max, `isContainer` by or, health by the worst status and severity, the
 * fingerprint union); histograms add up element by element over the minutes that have one.
 *
 * Idempotent and safe to re-run: an hour whose series hold one row each has nothing to fold. A
 * run folds the hours from the previous run's end (minus one day, for late pushes and missed
 * runs) up to the whole hour before the cutoff; without that mark (first run, cleared cache) it
 * starts at the oldest stored minute. Each project-hour is one transaction that locks its rows,
 * so a concurrent push either lands before the fold (and is folded) or after it (and is folded on
 * the next run).
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:37;s:7:"endLine";i:141;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:16:"FOLDED_UNTIL_KEY";a:12:{s:18:"declaringClassName";s:35:"App\Actions\DownsampleRuntimeAction";s:21:"implementingClassName";s:35:"App\Actions\DownsampleRuntimeAction";s:4:"name";s:16:"FOLDED_UNTIL_KEY";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:30:"'excubia.runtime_folded_until'";s:10:"attributes";a:6:{s:9:"startLine";i:40;s:7:"endLine";i:40;s:13:"startTokenPos";i:63;s:12:"startFilePos";i:2100;s:11:"endTokenPos";i:63;s:10:"endFilePos";i:2129;}}s:10:"docComment";s:71:"/** The cache key of the hour the last run folded up to (Unix time). */";s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:40;s:11:"startColumn";i:5;s:9:"endColumn";i:67;}s:14:"LOOKBACK_HOURS";a:12:{s:18:"declaringClassName";s:35:"App\Actions\DownsampleRuntimeAction";s:21:"implementingClassName";s:35:"App\Actions\DownsampleRuntimeAction";s:4:"name";s:14:"LOOKBACK_HOURS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"24";s:10:"attributes";a:6:{s:9:"startLine";i:43;s:7:"endLine";i:43;s:13:"startTokenPos";i:76;s:12:"startFilePos";i:2267;s:11:"endTokenPos";i:76;s:10:"endFilePos";i:2268;}}s:10:"docComment";s:95:"/** Hours before the last run's end that a run folds again, for late pushes and missed runs. */";s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:43;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:4:{s:7:"execute";a:20:{s:4:"name";s:7:"execute";s:10:"parameters";a:1:{s:6:"before";a:14:{s:4:"name";s:6:"before";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:22:"Carbon\CarbonImmutable";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b
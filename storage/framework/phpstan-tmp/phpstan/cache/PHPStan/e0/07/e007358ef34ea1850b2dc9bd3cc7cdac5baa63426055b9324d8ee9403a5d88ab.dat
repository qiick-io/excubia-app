 * Standard-tier list prices (USD) from SOURCES: input, cache read, cache write, output per 1M
 * tokens, then reasoning, image input and image output per 1M tokens, audio per second (no
 * search unit: no reranker default). Only models an official page prices are here: better no default than a wrong
 * one. One row per model, so tiered prices use the base tier: Anthropic's cache write is the
 * 5-minute write (the 1-hour write costs more), Claude Haiku 5.5 is priced for prompts up to
 * 100k tokens and Gemini 2.5 Pro for prompts up to 200k tokens (both cost more above), and
 * Gemini is priced for text, image and video input (audio input costs more). Gemini's output
 * price includes thinking tokens. The optional 11th value is the row's `effective_from`:
 * Gemini 3.8 Flash input, cache read and output double from 2027-01-01 (#202).
 *
 * @var list<array{0: string, 1: string, 2: float, 3: float|null, 4: float|null, 5: float, 6?: float|null, 7?: float|null, 8?: float|null, 9?: float|null, 10?: string}>
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:90;s:7:"endLine";i:113;s:11:"startColumn";i:5;s:9:"endColumn";i:6;}}s:19:"immediateProperties";a:2:{s:6:"prices";a:16:{s:18:"declaringClassName";s:27:"App\Services\AiPriceService";s:21:"implementingClassName";s:27:"App\Services\AiPriceService";s:4:"name";s:6:"prices";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:116;s:7:"endLine";i:116;s:13:"startTokenPos";i:654;s:12:"startFilePos";i:6869;s:11:"endTokenPos";i:654;s:10:"endFilePos";i:6872;}}s:10:"docComment";s:28:"/** @var list<Price>|null */";s:10:"attributes";a:0:{}s:9:"startLine";i:116;s:7:"endLine";i:116;s:11:"startColumn";i:5;s:9:"endColumn";i:34;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"settings";a:16:{s:18:"declaringClassName";s:27:"App\Services\AiPriceService";s:21:"implementingClassName";s:27:"App\Services\AiPriceService";s:4:"name";s:8:"settings";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:38:"App\Services\SettingsRepositoryService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:118;s:7:"endLine";i:118;s:11:"startColumn";i:33;s:9:"endColumn";i:75;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:11:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:1:{s:8
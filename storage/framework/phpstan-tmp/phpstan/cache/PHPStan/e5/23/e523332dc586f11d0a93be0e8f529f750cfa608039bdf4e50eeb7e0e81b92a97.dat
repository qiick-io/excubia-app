O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-274a702a645b9228326cc812e60684d58b6d3b986ba890dcd20ea1b8844aa98c-8.4.27-6.75.0.4";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:48:"Symfony\Contracts\HttpClient\HttpClientInterface";s:8:"filename";s:173:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/vendor/composer/../symfony/http-client-contracts/HttpClientInterface.php";}}s:9:"namespace";s:28:"Symfony\Contracts\HttpClient";s:4:"name";s:48:"Symfony\Contracts\HttpClient\HttpClientInterface";s:9:"shortName";s:19:"HttpClientInterface";s:11:"isInterface";b:1;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:201:"/**
 * Provides flexible methods for requesting HTTP resources synchronously or asynchronously.
 *
 * @see HttpClientTestCase for a reference test suite
 *
 * @author Nicolas Grekas <p@tchwork.com>
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:133;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:16:"OPTIONS_DEFAULTS";a:12:{s:18:"declaringClassName";s:48:"Symfony\Contracts\HttpClient\HttpClientInterface";s:21:"implementingClassName";s:48:"Symfony\Contracts\HttpClient\HttpClientInterface";s:4:"name";s:16:"OPTIONS_DEFAULTS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4079:"[
    // array|string - an array containing the username as first value, and optionally the
    //   password as the second one; or string like username:password - enabling HTTP Basic
    //   authentication (RFC 7617)
    'auth_basic' => null,
    // string - a token enabling HTTP Bearer authorization (RFC 6750)
    'auth_bearer' => null,
    // string[] - associative array of query string values to merge with the request's URL
    'query' => [],
    // iterable|string[]|string[][] - headers names provided as keys or as part of values
    'headers' => [],
    // array|string|resource|\Traversable|\Closure - the callback SHOULD yield a string
    // smaller than the amount requested as argument; the empty string signals EOF; if
    // an array is passed, it is meant as a form payload of field names and values
    'body' => '',
    // mixed - if set, implementations MUST set the "body" option to the JSON-encoded
    //   value and set the "content-type" header to a JSON-compatible value if it is not
    //   explicitly defined in the headers option - typically "application/json"
    'json' => null,
    // mixed - any extra data to attach to the request (scalar, callable, object...) that
    //   MUST be available via $response->getInfo('user_data') - not used internally
    'user_data' => null,
    // int - the maximum number of redirects to follow; a value lower than or equal to 0
    //   means redirects should not be followed; "Authorization" and "Cookie" headers MUST
    //   NOT follow except for the initial host name
    'max_redirects' => 20,
    // string - defaults to the best supported version, typically 1.1 or 2.0
    'http_version' => null,
    // string - the URI to resolve relative URLs, following rules in RFC 3986, section 2
    'base_uri' => null,
    // bool|resource|\Closure(array<string, list<string>> $headers): (bool|resource) - whether
    //   the content of the response should be buffered or not, or a stream resource where the
    //   response body should be written, or a closure telling if/where the response should be
    //   buffered based on its headers, which are keyed by lowercased header names
    'buffer' => true,
    // callable(int $dlNow, int $dlSize, array $info) - throwing any exceptions MUST abort the
    //   request; it MUST be called on connection, on headers and on completion; it SHOULD be
    //   called on upload/download of data and at least 1/s
    'on_progress' => null,
    // string[] - a map of host to IP address that SHOULD replace DNS resolution
    'resolve' => [],
    // string - by default, the proxy-related env vars handled by curl SHOULD be honored
    'proxy' => null,
    // string - a comma separated list of hosts that do not require a proxy to be reached
    'no_proxy' => null,
    // float - the idle timeout (in seconds) - defaults to ini_get('default_socket_timeout')
    'timeout' => null,
    // float - the maximum execution time (in seconds) for the request+response as a whole;
    //   a value lower than or equal to 0 means it is unlimited
    'max_duration' => 0,
    // float - the maximum duration (in seconds) allowed for DNS + TCP + TLS connection;
    //   a value lower than or equal to 0 means unlimited, as long as option timeout is respected
    'max_connect_duration' => 0,
    // string - the interface or the local socket to bind to
    'bindto' => '0',
    // see https://php.net/context.ssl for the following options
    'verify_peer' => true,
    'verify_host' => true,
    'cafile' => null,
    'capath' => null,
    'local_cert' => null,
    'local_pk' => null,
    'passphrase' => null,
    'ciphers' => null,
    'peer_fingerprint' => null,
    'capture_peer_cert_chain' => false,
    // STREAM_CRYPTO_METHOD_TLSv*_CLIENT - minimum TLS version
    'crypto_method' => \STREAM_CRYPTO_METHOD_TLSv1_2_CLIENT,
    // array - additional options that can be ignored if unsupported, unlike regular options
    'extra' => [
        // bool - whether to use persistent connections where supported
        'use_persistent_connections' => false,
    ],
]";s:10:"attributes";a:6:{s:9:"startLine";i:26;s:7:"endLine";i:99;s:13:"startTokenPos";i:35;s:12:"startFilePos";i:680;s:11:"endTokenPos";i:344;s:10:"endFilePos";i:5050;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:99;s:11:"startColumn";i:5;s:9:"endColumn";i:6;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:3:{s:7:"request";a:20:{s:4:"name";s:7:"request";s:10:"parameters";a:3:{s:6:"method";a:14:{s:4:"name";s:6:"method";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:113;s:7:"endLine";i:113;s:11:"startColumn";i:29;s:9:"endColumn";i:42;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:3:"url";a:14:{s:4:"name";s:3:"url";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:113;s:7:"endLine";i:113;s:11:"startColumn";i:45;s:9:"endColumn";i:55;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:7:"options";a:14:{s:4:"name";s:7:"options";s:7:"default";a:2:{s:4:"code";s:2:"[]";s:10:"attributes";a:6:{s:9:"startLine";i:113;s:7:"endLine";i:113;s:13:"startTokenPos";i:371;s:12:"startFilePos";i:5642;s:11:"endTokenPos";i:372;s:10:"endFilePos";i:5643;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:113;s:7:"endLine";i:113;s:11:"startColumn";i:58;s:9:"endColumn";i:76;s:14:"parameterIndex";i:2;s:10:"isOptional";b:1;}}s:16:"returns
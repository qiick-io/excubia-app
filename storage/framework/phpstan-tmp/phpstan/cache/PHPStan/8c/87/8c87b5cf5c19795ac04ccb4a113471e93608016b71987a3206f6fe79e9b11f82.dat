O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-76cf3670484447c40dd737b194de0ac7b964c5978254e6307af2373f0d6edb20";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:36:"App\Actions\StorePushedRuntimeAction";s:8:"filename";s:141:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/app/Actions/StorePushedRuntimeAction.php";}}s:9:"namespace";s:11:"App\Actions";s:4:"name";s:36:"App\Actions\StorePushedRuntimeAction";s:9:"shortName";s:24:"StorePushedRuntimeAction";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1426:"/**
 * Stores a runtime batch pushed by a project (#48, #111). Aggregates are additive, as
 * `docs/runtime-schema.json` asks: for the same type, minute bucket, sample rate, dimensions and
 * release the counts, errors and totals add up, maxima and server gauges keep the larger value,
 * `isContainer` is true when any entry is, and histograms add up element by element (none when
 * only one side has one), also across batches. Entries of a type this app does not know are
 * skipped and counted on the project (`skipped_runtime_aggregates`), so a newer core never loses
 * the rest of its batch; so are `health` samples with a `status` or `severity` the app does not
 * know, which it cannot rank (#169). Other enumerated values this app does not know (an `ai`
 * `operation`, a log `level`, an `outcome`…) are stored as any other dimension. A repeated `batchId` stores nothing and returns false. The same
 * transaction adds the entries to their hourly rollups (#137), which the dashboard totals read,
 * and the `ai` entries to the daily AI usage (#129).
 * After a new batch with `health` samples (#115) the health alerts are evaluated.
 *
 * The entries are merged in PHP first, then the series the batch touches are read in one query
 * (and locked by key when found) and the new ones written in one insert per chunk (#195): one read and one write per entry
 * held SQLite's single write lock for most of a push.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:347;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:1:{i:0;s:37:"App\Traits\StoresPushedBatchOnceTrait";}s:18:"immediateConstants";a:1:{s:6:"MERGED";a:12:{s:18:"declaringClassName";s:36:"App\Actions\StorePushedRuntimeAction";s:21:"implementingClassName";s:36:"App\Actions\StorePushedRuntimeAction";s:4:"name";s:6:"MERGED";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:70:"['count', 'error_count', 'total_ms', 'max_ms', 'metrics', 'histogram']";s:10:"attributes";a:6:{s:9:"startLine";i:40;s:7:"endLine";i:40;s:13:"startTokenPos";i:83;s:12:"startFilePos";i:1921;s:11:"endTokenPos";i:100;s:10:"endFilePos";i:1990;}}s:10:"docComment";s:45:"/** The columns merged() adds an entry to. */";s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:40;s:11:"startColumn";i:5;s:9:"endColumn";i:98;}}s:19:"immediateProperties";a:4:{s:17:"scheduledTaskRuns";a:16:{s:18:"declaringClassName";s:36:"App\Actions\StorePushedRuntimeAction";s:21:"implementingClassName";s:36:"App\Actions\StorePushedRuntimeAction";s:4:"name";s:17:"scheduledTaskRuns";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:40:"App\Actions\StoreScheduledTaskRunsAction";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:43;s:7:"endLine";i:43;s:11:"startColumn";i:9;s:9:"endColumn";i:63;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:7:"rollups";a:16:{s:18:"declaringClassName";s:36:"App\Actions\StorePushedRuntimeAction";s:21:"implementingClassName";s:36:"App\Actions\StorePushedRuntimeAction";s:4:"name";s:7:"rollups";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:37:"App
pe";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:906:"/**
 * Count the pending message as one failed mail (#175). Laravel has no
 * mail failure event, but the mailer fires `MessageSent` right after the
 * transport returns: a `MessageSending` with no `MessageSent` by the end
 * of its scope (the next send, the end of the queued job or attempt, the
 * end of the Artisan command, or the request or process terminating) is
 * a send that threw. This is the only source of mail failures, so it
 * works with exception capture off and counts each send once with it on.
 *
 * ponytail: a `MessageSending` listener registered after Excubia's that
 * cancels the send (returns false), or one that throws, is counted as a
 * failed mail; a job or command that runs inside a `MessageSending`
 * listener (a queued listener on the sync driver) counts the send as
 * failed and then as sent. Wrapping the mail transport is the upgrade
 * path if that ever matters.
 */";s:9:"startLine";i:1009;s:7:"endLine";i:1019;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:16:"currentClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:9:"aliasName";N;}s:18:"recordNotification";a:20:{s:4:"name";s:18:"recordNotification";s:10:"parameters";a:1:{s:5:"event";a:14:{s:4:"name";s:5:"event";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:48:"Illuminate\Notifications\Events\NotificationSent";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:50:"Illuminate\Notifications\Events\NotificationFailed";s:12:"isIdentifier";b:0;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:1021;s:7:"endLine";i:1021;s:11:"startColumn";i:40;s:9:"endColumn";i:81;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:1021;s:7:"endLine";i:1035;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:21:"implementingClassName";s:45:"Qiick
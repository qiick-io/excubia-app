 * Count one log entry by level and, when a watched channel wrote it,
 * channel. The message and context are never read. A message logged
 * while this runs (a deprecation raised inside Excubia) is ignored, so
 * the listener cannot loop.
 */";s:9:"startLine";i:1128;s:7:"endLine";i:1158;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:16:"currentClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:9:"aliasName";N;}s:20:"listenToDeprecations";a:20:{s:4:"name";s:20:"listenToDeprecations";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:1414:"/**
 * Chain a PHP error handler in front of the current one (Laravel's
 * `HandleExceptions`, which writes deprecations to the `deprecations`
 * log channel, when the provider boots). It records `E_DEPRECATED` and
 * `E_USER_DEPRECATED`, then always calls the previous handler with the
 * same arguments and returns its result, so Laravel's deprecation log,
 * its ErrorException for warnings, and any other chained handler (Sentry,
 * Flare…) behave as before. With no previous handler it returns false and
 * PHP's own handling continues.
 *
 * The handler is registered for every level, not with a level mask: PHP
 * sends the levels outside a mask to its built-in handler, not to the
 * previous one, so a mask would stop Laravel turning warnings into
 * exceptions. A request that raises no PHP error never calls it.
 *
 * Why the error handler and not Laravel's `deprecations` channel: the
 * `MessageLogged` event carries no channel, the log line holds the
 * absolute file and line in its text, and Laravel skips that channel in
 * unit tests and before the app is bootstrapped. The handler sees the
 * file directly and counts the same deprecations whatever the logging
 * configuration, and Laravel's channel keeps working because the handler
 * forwards to it.
 *
 * ponytail: a handler set later that does not forward to the previous
 * one hides deprecations from Excubia; it is not re-chained.
 */";s:9:"startLine";i:1186;s:7:"endLine";i:1200;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:16:"currentClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:9:"aliasName";N;}s:17:"recordDeprecation";a:20:{s:4:"name";s:17:"recordDeprecation";s:10:"parameters";a:2:{s:7:"message";a:14:{s:4:"name";s:7:"message";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:1208;s:7:"endLine";i:1208;s:11:"startColumn";i:39;s:9:"endColumn";i:53;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"file";a:14:{s:4:"name";s:4:"file";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:1208;s:7:"endLine";i:1208;s:11:"startColumn";i:56;s:9:"endColumn";i:67;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:236:"/**

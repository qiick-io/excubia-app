 * Learn the channel name of each log entry (#174) without touching the
 * message or the context: append `LogChannelTapService` to the `tap`
 * list of every configured channel, so Laravel calls it when it
 * resolves the channel, and watch the channels it already resolved.
 * The other taps of a channel are kept and run first.
 *
 * Why a tap and a processor, not `LogManager::extend()` or a handler:
 * `MessageLogged` carries no channel, but Laravel fires it right after
 * Monolog wrote the record, and Monolog runs the processors before the
 * handlers. A tap keeps every driver as configured and is lazy.
 *
 * ponytail: on-demand channels (`Log::build()`, `Log::stack([...])`)
 * have no configuration to tap, so their entries have no channel unless
 * they copy a tapped channel's processors (a stack of named channels
 * reports the first one). An entry whose handler throws fires no
 * `MessageLogged`; its channel is overwritten by the next entry.
 */";s:9:"startLine";i:1055;s:7:"endLine";i:1095;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:18:"declaringClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:16:"currentClassName";s:45:"Qiick\Excubia\Laravel\RuntimeCollectorService";s:9:"aliasName";N;}s:15:"watchLogChannel";a:20:{s:4:"name";s:15:"watchLogChannel";s:10:"parameters";a:2:{s:6:"logger";a:14:{s:4:"name";s:6:"logger";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:21:"Illuminate\Log\Logger";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:1102;s:7:"endLine";i:1102;s:11:"startColumn";i:37;s:9:"endColumn";i:50;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:7:"channel";a:14:{s:4:"name";s:7:"channel";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:1102;s:7:"endLine";i:1102;s:11:"startColumn";i:53;s:9:"endColumn";i:67;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:212:"/**

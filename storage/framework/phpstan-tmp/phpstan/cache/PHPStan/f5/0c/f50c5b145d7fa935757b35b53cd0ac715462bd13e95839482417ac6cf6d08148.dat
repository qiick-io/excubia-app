 * Adds runtime minutes to their hourly rollups (#137): per project, type, hour and sample rate,
 * the counts, errors and total durations add up, as they do on the minute aggregates. The
 * minutes are summed in PHP first, so one upsert holds each hour once (PostgreSQL refuses a row
 * twice in one statement), and the database adds them to the stored hour atomically, on SQLite,
 * MySQL and PostgreSQL alike. Used at ingest and by the one-off backfill.
 *
 * @phpstan-type Minute array{project_id: int, type: string, bucket: DateTimeInterface|string, sample_rate: float, count: int, error_count: int, total_ms: float|null}
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:61;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:1:{i:0;s:28:"App\Traits\AddsOnUpsertTrait";}s:18:"immediateConstants";a:2:{s:5:"CHUNK";a:12:{s:18:"declaringClassName";s:37:"App\Actions\StoreRuntimeRollupsAction";s:21:"implementingClassName";s:37:"App\Actions\StoreRuntimeRollupsAction";s:4:"name";s:5:"CHUNK";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"500";s:10:"attributes";a:6:{s:9:"startLine";i:27;s:7:"endLine";i:27;s:13:"startTokenPos";i:63;s:12:"startFilePos";i:1033;s:11:"endTokenPos";i:63;s:10:"endFilePos";i:1035;}}s:10:"docComment";s:74:"/** Hours per statement, so one stays below the bound-parameter limits. */";s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:27;s:11:"startColumn";i:5;s:9:"endColumn";i:30;}s:4:"SUMS";a:12:{s:18:"declaringClassName";s:37:"App\Actions\StoreRuntimeRollupsAction";s:21:"implementingClassName";s:37:"App\Actions\StoreRuntimeRollupsAction";s:4:"name";s:4:"SUMS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:36:"['count', 'error_count', 'total_ms']";s:10:"attributes";a:6:{s:9:"startLine";i:30;s:7:"endLine";i:30;s:13:"startTokenPos";i:76;s:12:"startFilePos";i:1095;s:11:"endTokenPos";i:84;s:10:"endFilePos";i:1130;}}s:10:"docComment";s:26:"/** The summed columns. */";s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:30;s:11:"startColumn";i:5;s:9:"endColumn";i:62;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:7:"execute";a:20:{s:4:"name";s:7:"execute";s:10:"parameters";a:1:{s:7:"minutes";a:14:{s:4:"name";s:7:"minutes";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:8:"iterable";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7
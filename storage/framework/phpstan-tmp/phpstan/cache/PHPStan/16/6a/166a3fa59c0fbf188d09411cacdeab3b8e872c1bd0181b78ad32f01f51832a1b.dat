 * Delivers one alert (#22) to one channel, as externa-core's outbound webhook and notifier jobs:
 * - webhook: JSON body signed with HMAC-SHA256 of `timestamp.body` (`X-Excubia-Signature`);
 * - slack: an incoming-webhook message;
 * - telegram: a Bot API sendMessage;
 * - email:<user id>: an AlertMail to that user, in their locale (the user must still be active).
 * HTTPS only, no redirects, and hosts that resolve to private or reserved addresses are refused;
 * the connection goes to the checked address, and transport errors never quote the URL.
 * Retried 3 times with backoff; the webhook's last success and last error are kept for Settings,
 * and every channel's outcome goes on the alert's history row (#114). A grouped message (one
 * report push, #22) carries the worst alert's payload and lists every alert in `alerts`, whose
 * history rows all get the outcome.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:235;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:1:{i:0;s:38:"Illuminate\Contracts\Queue\ShouldQueue";}s:15:"traitClassNames";a:1:{i:0;s:37:"Illuminate\Foundation\Queue\Queueable";}s:18:"immediateConstants";a:4:{s:7:"WEBHOOK";a:12:{s:18:"declaringClassName";s:24:"App\Jobs\DeliverAlertJob";s:21:"implementingClassName";s:24:"App\Jobs\DeliverAlertJob";s:4:"name";s:7:"WEBHOOK";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:9:"'webhook'";s:10:"attributes";a:6:{s:9:"startLine";i:37;s:7:"endLine";i:37;s:13:"startTokenPos";i:100;s:12:"startFilePos";i:1450;s:11:"endTokenPos";i:100;s:10:"endFilePos";i:1458;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:37;s:7:"endLine";i:37;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}s:5:"SLACK";a:12:{s:18:"declaringClassName";s:24:"App\Jobs\DeliverAlertJob";s:21:"implementingClassName";s:24:"App\Jobs\DeliverAlertJob";s:4:"name";s:5:"SLACK";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:7:"'slack'";s:10:"attributes";a:6:{s:9:"startLine";i:39;s:7:"endLine";i:39;s:13:"startTokenPos";i:111;s:12:"startFilePos";i:1487;s:11:"endTokenPos";i:111;s:10:"endFilePos";i:1493;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:39;s:11:"startColumn";i:5;s:9:"endColumn";i:33;}s:8:"TELEGRAM";a:12:{s:18:"declaringClassName";s:24:"App\Jobs\DeliverAlertJob";s:21:"implementingClassName";s:24:"App\Jobs\DeliverAlertJob";s:4:"name";s:8:"TELEGRAM";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:10:"'telegram'";s:10:"attributes";a:6:{s:9:"startLine";i:41;s:7:"endLine";i:41;s:13:"startTokenPos";i:122;s:12:"startFilePos";i:1525;s:11:"endTokenPos";i:122;s:10:"endFilePos";i:1534;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:41;s:7:"endLine";i:41;s:11:"startColumn";i:5;s:9:"endColumn";i:39;}s:5:"EMAIL";a:12:{s:18:"declaringClassName";s:24:"App\
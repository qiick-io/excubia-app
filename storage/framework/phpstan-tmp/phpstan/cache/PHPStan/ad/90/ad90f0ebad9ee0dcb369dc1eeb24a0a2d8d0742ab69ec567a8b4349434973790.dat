O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-58d24e6e57c4ae2d4461312c6d3d9d32e049c8878b176f5d4dc49ab578624b3b-8.4.27-6.75.0.4";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"Qiick\Excubia\Data\RuntimeConfigurationData";s:8:"filename";s:176:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/vendor/composer/../qiick/excubia-core/src/Data/RuntimeConfigurationData.php";}}s:9:"namespace";s:18:"Qiick\Excubia\Data";s:4:"name";s:43:"Qiick\Excubia\Data\RuntimeConfigurationData";s:9:"shortName";s:24:"RuntimeConfigurationData";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:65568;s:10:"docComment";s:1599:"/**
 * The `runtime` key of `excubia.json`: opt-in runtime aggregates collected
 * by the Laravel provider and sent with `excubia:push-runtime`.
 *
 * Off by default. When `isEnabled` is false the provider registers no
 * listener and no schedule. Each type has its own switch and sample rate
 * (0 to 1, the share of events recorded, as in Laravel Pulse); every
 * aggregate carries its rate so the app can scale counts by `1 / sampleRate`.
 * `duplicateQueryThreshold` is how many times one query shape must run
 * within one request or job before `duplicateQuery` records it (#148).
 * `ignoredCommands` are the Artisan command names, `*` wildcards allowed,
 * that `command` never records (#152); Excubia's own `excubia:*` commands
 * are never recorded whatever the list holds.
 * `serverName` names this machine in `server` aggregates: the
 * `EXCUBIA_SERVER_NAME` environment variable (#162), else
 * `runtime.server.name` (#149); without it the server is a hashed id, never
 * the hostname. `isServerNameVariableInvalid` is true when the variable is
 * set but does not match SERVER_NAME_PATTERN: the server is then the hashed
 * id, and `excubia:push-runtime` warns.
 * `healthCheckIds` are the checks the `health` type runs (#188), a subset of
 * HEALTH_CHECK_IDS, which only probe local services and never call a data
 * source. A check starts only while `healthCheckBudgetMs` is still left of
 * `healthTotalBudgetMs`, counted from the start of the push-runtime run.
 * `bufferMaxBytes` caps the local buffer under `storage/excubia/runtime/`;
 * the oldest entries are dropped first.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:175;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:11:{s:31:"DEFAULT_SLOW_QUERY_THRESHOLD_MS";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Data\RuntimeConfigurationData";s:21:"implementingClassName";s:43:"Qiick\Excubia\Data\RuntimeConfigurationData";s:4:"name";s:31:"DEFAULT_SLOW_QUERY_THRESHOLD_MS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4:"1000";s:10:"attributes";a:6:{s:9:"startLine";i:38;s:7:"endLine";i:38;s:13:"startTokenPos";i:45;s:12:"startFilePos";i:1865;s:11:"endTokenPos";i:45;s:10:"endFilePos";i:1868;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:5;s:9:"endColumn";i:56;}s:33:"DEFAULT_DUPLICATE_QUERY_THRESHOLD";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Data\RuntimeConfigurationData";s:21:"implementingClassName";s:43:"Qiick\Excubia\Data\RuntimeConfigurationData";s:4:"name";s:33:"DEFAULT_DUPLICATE_QUERY_THRESHOLD";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"5";s:10:"attributes";a:6:{s:9:"startLine";i:44;s:7:"endLine";i:44;s:13:"startTokenPos";i:58;s:12:"startFilePos";i:2058;s:11:"endTokenPos";i:58;s:10:"endFilePos";i:2058;}}s:10:"docComment";s:116:"/**

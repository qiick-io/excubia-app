O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-8f9b3c262d149ae77f5e730f9bc33263e9dce8d29960552f74a82fb1b72af30e";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:35:"App\Services\AlertDispatcherService";s:8:"filename";s:140:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/app/Services/AlertDispatcherService.php";}}s:9:"namespace";s:12:"App\Services";s:4:"name";s:35:"App\Services\AlertDispatcherService";s:9:"shortName";s:22:"AlertDispatcherService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1096:"/**
 * Sends an alert (#22) to the configured channels, as queued jobs: the signed webhook, Slack and
 * Telegram each take the events, minimum severity and projects chosen for them in Settings →
 * Integrations; every user who turned alert emails on gets a mail when their own filters take
 * it and they can see the project. Nothing is queued when no channel takes the alert. An event
 * without a finding severity takes the admin's severity for it, else its default.
 *
 * Every alert passes through here, so this is where mutes, maintenance windows and maintenance
 * mode suppress it (AlertSuppressionService) and where the alert history row is written (#114).
 * The finding fingerprints of the alert are kept on that row, for the duplicate check and the
 * health re-alert (#143).
 *
 * Inside grouped(), the alerts raised together (one report push) go out as one Slack, Telegram
 * and email message per channel instead of one per alert; the webhook still gets one signed
 * request per alert, so its payload and event ids stay as they are. Every alert keeps its own
 * history row.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:265;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:13:"GROUPED_LINES";a:12:{s:18:"declaringClassName";s:35:"App\Services\AlertDispatcherService";s:21:"implementingClassName";s:35:"App\Services\AlertDispatcherService";s:4:"name";s:13:"GROUPED_LINES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"15";s:10:"attributes";a:6:{s:9:"startLine";i:38;s:7:"endLine";i:38;s:13:"startTokenPos";i:83;s:12:"startFilePos";i:1598;s:11:"endTokenPos";i:83;s:10:"endFilePos";i:1599;}}s:10:"docComment";s:105:"/** Lines listed in one grouped Slack or Telegram message; Telegram caps a message at 4096 characters. */";s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:5;s:9:"endColumn";i:36;}}s:19:"immediateProperties";a:3:{s:5:"group";a:16:{s:18:"declaringClassName";s:35:"App\Services\AlertDispatcherService";s:21:"implementingClassName";s:35:"App\Services\AlertDispatcherService";s:4:"name";s:5:"group";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:45;s:7:"endLine";i:45;s:13:"startTokenPos";i:97;s:12:"startFilePos";i:1813;s:11:"endTokenPos";i:97;s:10:"endFilePos";i:1816;}}s:10:"docComment";s:161:"/**

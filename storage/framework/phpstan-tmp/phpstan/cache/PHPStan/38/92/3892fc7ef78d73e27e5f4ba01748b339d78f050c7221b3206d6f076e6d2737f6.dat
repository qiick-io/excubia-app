 * Counts the 4xx answers of the push endpoints (#117) for the System page, around the throttle
 * and the token check, so 429, 401, 403, 413 and 422 are all seen. The reason is a fixed word
 * or, for a 422, the first invalid field with list indexes as `*`
 * (`runtime.aggregates.*.count`): field names come from the push schema, never values, the body
 * or the token. Recording never changes the answer.
 *
 * Token rejections also raise `push.rejected` (#22) once `excubia.push_rejected_alert_after`
 * of them come within an hour: per project for a disabled one (403), per client for a missing,
 * unknown or revoked token (401), which has no project and so alerts on the system project
 * (#70). The client is only a hashed cache key that expires with the hour: no IP is stored.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:30;s:7:"endLine";i:117;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:4:{s:6:"handle";a:20:{s:4:"name";s:6:"handle";s:10:"parameters";a:2:{s:7:"request";a:14:{s:4:"name";s:7:"request";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:23:"Illuminate\Http\Request";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:28;s:9:"endColumn";i:43;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"next";a:14:{s:4:"name";s:4:"next";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:7:"Closure";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:46;s:9:"endColumn";i:58;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:41:"Symfony\Component\HttpFoundation\Response";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:0:{}s:10:"docComment";s:54:"/**

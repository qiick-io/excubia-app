 * Load, CPU cores and memory read with PHP alone, never through a shell.
 *
 * - Linux: `/proc/loadavg`, `/proc/cpuinfo` and `/proc/meminfo`.
 * - Elsewhere (macOS, BSD): the load average from `sys_getloadavg()`; CPU
 *   cores and memory are null, since only `sysctl` or `vm_stat` expose them
 *   there and Excubia does not start processes.
 *
 * ponytail: macOS cores and memory need `sysctl hw.ncpu hw.memsize` and
 * `vm_stat`; read them through `symfony/process` if it ever becomes a
 * dependency of this package. Production servers are Linux.
 *
 * - Containers (#173): inside Docker or Kubernetes `/proc` shows the host.
 *   When the cgroup of the process has a memory limit, memory is the
 *   cgroup's (used minus inactive page cache, out of the limit); when it
 *   has a CPU quota, `cpuLimit()` is quota / period in cores. cgroup v2
 *   (`memory.max`, `memory.current`, `cpu.max`) is tried first, then v1
 *   (`memory/memory.limit_in_bytes`, `memory/memory.usage_in_bytes`,
 *   `cpu/cpu.cfs_quota_us`, `cpu/cpu.cfs_period_us`). `max`, `-1`, a v1
 *   "unlimited" value and a limit at or above the machine's memory are no
 *   limit. `isContainer()` is true when either limit applies.
 *
 * ponytail: only the cgroup mounted at `/sys/fs/cgroup` is read, which is
 * the process's own one inside a container (cgroup namespace). A host
 * process in a limited systemd slice is not seen; resolving
 * `/proc/self/cgroup` would cover it if that is ever needed.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:289;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:1:{i:0;s:47:"Qiick\Excubia\Contracts\ServerResourcesContract";}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:8:"KIBIBYTE";a:12:{s:18:"declaringClassName";s:45:"Qiick\Excubia\Services\ServerResourcesService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Services\ServerResourcesService";s:4:"name";s:8:"KIBIBYTE";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:4:"1024";s:10:"attributes";a:6:{s:9:"startLine";i:38;s:7:"endLine";i:38;s:13:"startTokenPos";i:42;s:12:"startFilePos";i:1705;s:11:"endTokenPos";i:42;s:10:"endFilePos";i:1708;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:5;s:9:"endColumn";i:34;}s:22:"CGROUP_UNLIMITED_BYTES";a:12:{s:18:"declaringClassName";s:45:"Qiick\Excubia\Services\ServerResourcesService";s:21:"implementingClassName";s:45:"Qiick\Excubia\Services\ServerResourcesService";s:4:"name";s:22:"CGROUP_UNLIMITED_BYTES";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:7:"1 << 60";s:10:"attributes";a:6:{s:9:"startLine";i:44;s:7:"endLine";i:44;s:13:"startTokenPos";i:55;s:12:"startFilePos";i:1907;s:11:"endTokenPos";i:59;s:10:"endFilePos";i:1913;}}s:10:"docComment";s:135:"/**

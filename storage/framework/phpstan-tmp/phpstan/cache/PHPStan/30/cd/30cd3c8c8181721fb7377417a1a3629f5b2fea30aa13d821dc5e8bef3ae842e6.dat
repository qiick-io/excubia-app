 * Sanctum's `expiration` (minutes; null or 0 means tokens never expire,
 * as for Sanctum's guard) and `stateful` domains (a `*` pattern, or no
 * domain at all), plus counts from `personal_access_tokens` on the
 * default connection: the tokens still valid (no past `expires_at`,
 * younger than `expiration`), those without `expires_at`, those not
 * used for STALE_TOKEN_DAYS (`last_used_at`, or `created_at` for a
 * token never used) and those never used. Timestamps are compared in
 * the app's timezone, as Eloquent writes them. A missing or unreadable
 * table leaves the counts null. Never a token, a name, an ability, a
 * user id or a domain.
 *
 * ponytail: the table is always `personal_access_tokens` on the default
 * connection; read the model of `Sanctum::$personalAccessTokenModel`
 * if an app with a custom token table ever needs it.
 *
 * @param  array<mixed>  $sanctum
 * @return array{provider: 'sanctum', expirationMinutes: int|null, hasStatefulWildcard: bool, isStatefulEmpty: bool, tokenCount: int|null, nonExpiringTokenCount: int|null, staleTokenCount: int|null, neverUsedTokenCount: int|null}
 */";s:9:"startLine";i:416;s:7:"endLine";i:466;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:18:"declaringClassName";s:43:"Qiick\Excubia\Laravel\LaravelPostureService";s:21:"implementingClassName";s:43:"Qiick\Excubia\Laravel\LaravelPostureService";s:16:"currentClassName";s:43:"Qiick\Excubia\Laravel\LaravelPostureService";s:9:"aliasName";N;}s:8:"passport";a:20:{s:4:"name";s:8:"passport";s:10:"parameters";a:2:{s:11:"application";a:14:{s:4:"name";s:11:"application";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"Illuminate\Contracts\Foundation\Application";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:483;s:7:"endLine";i:483;s:11:"startColumn";i:31;s:9:"endColumn";i:54;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:6:"config";a:14:{s:4:"name";s:6:"config";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:38:"Illuminate\Contracts\Config\Repository";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:483;s:7:"endLine";i:483;s:11:"startColumn";i:57;s:9:"endColumn";i:74;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:1001:"/**
 * Passport's keys, token lifetimes and personal access clients. A key
 * comes from `passport.private_key` / `passport.public_key`, else from
 * the file `Passport::keyPath()` names, as Passport's provider loads it;
 * the private key file is too open when its mode is not one that
 * league/oauth2-server accepts (0400, 0440, 0600, 0640, 0660; not
 * checked on Windows). The lifetimes are `Passport::$tokensExpireIn`,
 * `$refreshTokensExpireIn` and `$personalAccessTokensExpireIn`, one year
 * each when unset. Active personal access clients are counted in
 * `oauth_clients` on `passport.connection`: `grant_types` holding
 * `personal_access` (Passport 13), or `personal_access_client`
 * (Passport 12). Never a key, a path, a client name, id or secret.
 *
 * @return array{provider: 'passport', hasKeys: bool, isPrivateKeyTooOpen: bool|null, accessTokenLifetimeMinutes: int, refreshTokenLifetimeMinutes: int, personalAccessTokenLifetimeMinutes: int, personalAccessClientCount: int|null}
 */";s:9:"startLine";i:483;s:7:"endLine";i:533;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:21:"Qiick\Excubia\Laravel";s:18:"declaringClassName";s:43:"Qiick\Excubia\Laravel\LaravelPostureService";s:21:"implementingClassName";s:43:"Qiick\Excubia\Laravel\LaravelPostureService";s:16:"currentClassName";s:43:"Qiick\Excubia\Laravel\LaravelPostureService";s:9:"aliasName";N;}s:23:"passportLifetimeMinutes";a:20:{s:4:"name";s:23:"passportLifetimeMinutes";s:10:"parameters";a:1:{s:8:"property";a:14:{s:4:"name";s:8:"property";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:539;s:7:"endLine";i:539;s:11:"startColumn";i:46;s:9:"endColumn";i:61;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:145:"/**

O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-e1497ec1b4808c3b505e8d560e3f8617e781cfc9f4a9f966fc7116ef03e8df6c-8.4.27-6.75.0.4";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:8:"filename";s:176:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/vendor/composer/../qiick/excubia-core/src/Services/RuntimeBufferService.php";}}s:9:"namespace";s:22:"Qiick\Excubia\Services";s:4:"name";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:9:"shortName";s:20:"RuntimeBufferService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1279:"/**
 * Local, size-capped buffer of runtime aggregates (`docs/runtime-schema.json`)
 * between the Laravel collector and `excubia:push-runtime`. Exception capture
 * uses a second instance on its own directory (`storage/excubia/exceptions/`)
 * with the same files, lock, cap and batch ids, and reads it with
 * `readEntries()`.
 *
 * Layout of the directory (`storage/excubia/runtime/` in a Laravel app):
 *
 * - `buffer.ndjson`: one aggregate per line, appended at the end of each
 *   request, job or scheduled task;
 * - `batch-<sequence>-<batchId>.ndjson`: the buffer as it was when a push
 *   claimed it. The batch id lives in the file name, so every retry of a
 *   batch that the app did not acknowledge sends the same `batchId`;
 * - `.lock`: every append, claim and trim holds an exclusive `flock` on it,
 *   so a claim never loses a line that a request is writing.
 *
 * When the files together grow past the cap, whole lines are dropped from
 * the oldest file first (the oldest batch, then the buffer). The cap is
 * checked on every append. Nothing in this class talks to the network.
 *
 * ponytail: one flock per append serialises concurrent writers on one host;
 * enough for PHP-FPM pools. A shared buffer across hosts would need a store
 * such as Redis.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:801;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:17:{s:11:"BUFFER_FILE";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:21:"implementingClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:4:"name";s:11:"BUFFER_FILE";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:15:"'buffer.ndjson'";s:10:"attributes";a:6:{s:9:"startLine";i:38;s:7:"endLine";i:38;s:13:"startTokenPos";i:48;s:12:"startFilePos";i:1556;s:11:"endTokenPos";i:48;s:10:"endFilePos";i:1570;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:5;s:9:"endColumn";i:47;}s:9:"LOCK_FILE";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:21:"implementingClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:4:"name";s:9:"LOCK_FILE";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:7:"'.lock'";s:10:"attributes";a:6:{s:9:"startLine";i:40;s:7:"endLine";i:40;s:13:"startTokenPos";i:59;s:12:"startFilePos";i:1604;s:11:"endTokenPos";i:59;s:10:"endFilePos";i:1610;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:40;s:7:"endLine";i:40;s:11:"startColumn";i:5;s:9:"endColumn";i:38;}s:15:"MAX_BATCH_BYTES";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:21:"implementingClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:4:"name";s:15:"MAX_BATCH_BYTES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:10:"512 * 1024";s:10:"attributes";a:6:{s:9:"startLine";i:49;s:7:"endLine";i:49;s:13:"startTokenPos";i:72;s:12:"startFilePos";i:2011;s:11:"endTokenPos";i:76;s:10:"endFilePos";i:2020;}}s:10:"docComment";s:333:"/**
 * Largest claimed batch, in bytes of its entries as the push body
 * encodes them (SymfonyHttpClientService::JSON_BODY_FLAGS), #249. Half of
 * excubia-app's default body limit (`EXCUBIA_PUSH_MAX_KILOBYTES`, 1024
 * KB), so the envelope never pushes a batch over it. A single
 * entry larger than this is a batch of its own.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:49;s:7:"endLine";i:49;s:11:"startColumn";i:5;s:9:"endColumn";i:46;}s:13:"BATCH_PATTERN";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:21:"implementingClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:4:"name";s:13:"BATCH_PATTERN";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:98:"'/^batch-(\d{20})-([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})\.ndjson$/'";s:10:"attributes";a:6:{s:9:"startLine";i:51;s:7:"endLine";i:51;s:13:"startTokenPos";i:87;s:12:"startFilePos";i:2058;s:11:"endTokenPos";i:87;s:10:"endFilePos";i:2155;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:51;s:7:"endLine";i:51;s:11:"startColumn";i:5;s:9:"endColumn";i:133;}s:14:"COUNTER_FIELDS";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:21:"implementingClassName";s:43:"Qiick\Excubia\Services\RuntimeBufferService";s:4:"name";s:14:"COUNTER_FIELDS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:670:"['count', 'errorCount', 'hits', 'misses', 'writes', 'deletes', 'totalRepeats', 'failoverCount', 'workerStarts', 'workerStops', 'requests', 'tasks', 'ticks', 'totalRequestsAtStop', 'connectionsOpened', 'connectionsPruned', 'connectionsRejected', 'messagesReceived', 'messagesSent', 'publicChannelsCreated', 'privateChannelsCreated', 'presenceChannelsCreated', 'publicChannelsRemoved', 'privateChannelsRemoved', 'presenceChannelsRemoved', 'handledCount', 'paymentFailedCount', 'paymentActionRequiredCount', 'subscriptionCanceledCount', 'loginCount', 'lockoutCount', 'tokenAuthenticationCount', 'modelCount', 'activeCount', 'inactiveCount', 'resolvedCount', 'unknownCount']";s:10:"attributes";a:6:{s:9:"startLine";i:63;s:7:"endLine";i:63;s:13:"startTokenPos";i:100;s:12:"startFilePos";i:2812;s:11:"endTokenPos";i:210;s:10:"endFilePos";i:3481;}}s:10:"docComment";s:577:"/**

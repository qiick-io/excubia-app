 * Stores a runtime or exceptions batch once per `batchId` (#48), safe under concurrent pushes
 * (#195). The batch id and the batch's rows go in one transaction, which runs again when the
 * database reports a deadlock (MySQL's gap and upsert locks between concurrent pushes) or, past
 * the busy timeout, a locked SQLite file. A unique violation means a duplicate only when the
 * batch id is already stored; otherwise a concurrent batch of the same project created one of
 * the same series first, and the transaction runs again to add to it.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:55;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:14:"STORE_ATTEMPTS";a:12:{s:18:"declaringClassName";s:37:"App\Traits\StoresPushedBatchOnceTrait";s:21:"implementingClassName";s:37:"App\Traits\StoresPushedBatchOnceTrait";s:4:"name";s:14:"STORE_ATTEMPTS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:1:"5";s:10:"attributes";a:6:{s:9:"startLine";i:25;s:7:"endLine";i:25;s:13:"startTokenPos";i:63;s:12:"startFilePos";i:972;s:11:"endTokenPos";i:63;s:10:"endFilePos";i:972;}}s:10:"docComment";s:89:"/** Tries of the store transaction, for deadlocks and for series created concurrently. */";s:10:"attributes";a:0:{}s:9:"startLine";i:25;s:7:"endLine";i:25;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:9:"storeOnce";a:20:{s:4:"name";s:9:"storeOnce";s:10:"parameters";a:4:{s:7:"project";a:14:{s:4:"name";s:7:"project";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:18:"App\Models\Project";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:32;s:9:"endColumn";i:47;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"type";a:14:{s:4:"name";s:4:"type";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:50;s:9:"endColumn";i:61;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:7:"batchId";a:14:{s:4:"name";s:7:"batchId";s:7:"d
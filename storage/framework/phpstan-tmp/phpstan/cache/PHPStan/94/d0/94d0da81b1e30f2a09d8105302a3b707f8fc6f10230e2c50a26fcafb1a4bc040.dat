 */";s:9:"startLine";i:230;s:7:"endLine";i:247;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:20;s:9:"namespace";s:17:"App\Http\Requests";s:18:"declaringClassName";s:43:"App\Http\Requests\StorePushedRuntimeRequest";s:21:"implementingClassName";s:43:"App\Http\Requests\StorePushedRuntimeRequest";s:16:"currentClassName";s:43:"App\Http\Requests\StorePushedRuntimeRequest";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}
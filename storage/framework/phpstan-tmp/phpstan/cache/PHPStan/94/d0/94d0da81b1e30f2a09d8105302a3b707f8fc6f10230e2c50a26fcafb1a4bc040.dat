 * Rules for one aggregate of a known type, keyed by its field (`histogram.*` included).
 * Dimensions are strings (empty allowed, as core sends an empty queue name), enumerated ones
 * included (#169); those with a pattern must match it.
 *
 * The element rules of a list (`histogram.*`, `fingerprints.*`) are left out when every
 * element plainly passes them: the validator expands each wildcard over the whole flattened
 * body, which made them about a third of the validation time of a runtime push (#195). Any
 * other value keeps the rule, so what is rejected, and the error keys, stay the same.
 *
 * @param  array<string, mixed>  $aggregate
 * @return array<string, list<mixed>>
 */";s:9:"startLine";i:182;s:7:"endLine";i:221;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:17:"App\Http\Requests";s:18:"declaringClassName";s:43:"App\Http\Requests\StorePushedRuntimeRequest";s:21:"implementingClassName";s:43:"App\Http\Requests\StorePushedRuntimeRequest";s:16:"currentClassName";s:43:"App\Http\Requests\StorePushedRuntimeRequest";s:9:"aliasName";N;}s:8:"isListOf";a:20:{s:4:"name";s:8:"isListOf";s:10:"parameters";a:2:{s:6:"values";a:14:{s:4:"name";s:6:"values";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"mixed";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:230;s:7:"endLine";i:230;s:11:"startColumn";i:38;s:9:"endColumn";i:50;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:7:"isValid";a:14:{s:4:"name";s:7:"isValid";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:8:"callable";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:230;s:7:"endLine";i:230;s:11:"startColumn";i:53;s:9:"endColumn";i:69;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:289:"/**

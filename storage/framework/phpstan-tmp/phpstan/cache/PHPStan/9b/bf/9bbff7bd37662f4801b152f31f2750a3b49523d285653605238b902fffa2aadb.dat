 * Stores an exceptions batch pushed by a project (#49), grouped by fingerprint and environment
 * as `docs/exception-schema.json` asks: the count adds up and first / last seen widen, also
 * across batches. The first occurrence's message and frames are kept; the context follows the
 * latest occurrence. A resolved group reopens when it occurs again; an ignored one stays
 * ignored. A repeated `batchId` stores nothing and returns false.
 *
 * The batch's optional `release` (#106) is kept as the group's first and last release. A
 * resolved group that comes back in another release than the one it was last seen in is a
 * regression in that release (the fix shipped and did not hold); coming back in the same
 * release only reopens it, as the fix may not be deployed yet.
 *
 * Each group's count is also added to the minute of its last occurrence (#113), for the group's
 * chart: the payload has no time per occurrence.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:131;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:1:{i:0;s:37:"App\Traits\StoresPushedBatchOnceTrait";}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:3:{s:7:"execute";a:20:{s:4:"name";s:7:"execute";s:10:"parameters";a:4:{s:7:"project";a:14:{s:4:"name";s:7:"project";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:18:"App\Models\Project";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:29;s:9:"endColumn";i:44;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:7:"batchId";a:14:{s:4:"name";s:7:"batchId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:47;s:9:"endColumn";i:61;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:6:"groups";a:14:{s:4:"name";s:6:"groups";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:64;s:9:"endColumn";i:76;s:14:"parameterIndex";i:2;s:10:"isOptional";b:0;}s:7:"release";a:14:{s:4:"name";s:7:"release";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:38;s:7:"endLine";i:38;s:13:"startTokenPos";i:88;s:12:"startFilePos";i:1591;s:11:"en
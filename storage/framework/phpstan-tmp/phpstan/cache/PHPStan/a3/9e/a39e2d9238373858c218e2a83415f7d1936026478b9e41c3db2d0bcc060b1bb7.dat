O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-e1d46f561d2215e2ecfd1d875bd82b72a269167692ede0671976915031391d19";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:34:"App\Services\SelfMonitoringService";s:8:"filename";s:139:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/app/Services/SelfMonitoringService.php";}}s:9:"namespace";s:12:"App\Services";s:4:"name";s:34:"App\Services\SelfMonitoringService";s:9:"shortName";s:21:"SelfMonitoringService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1087:"/**
 * Excubia watches its own runtime and exceptions (#84): excubia-core's collectors run on this
 * app with `resources/excubia/self-monitoring.json`, writing to the core's local buffers, which
 * `excubia:system-telemetry` stores on the system project. The project's own `excubia.json` is
 * not used for this, so the core never schedules its HTTP `excubia:push-runtime` here.
 *
 * The runtime types (#219) are not read from that shipped file, which an upgrade overwrites:
 * they come from `EXCUBIA_SELF_MONITORING_TYPES`, else from defaults derived from the installed
 * core, every type the core collects and this app stores, with the chatty `cache` sampled.
 *
 * `server` and `health` are no event types: in a monitored app `excubia:push-runtime` samples
 * them each run. Here `excubia:system-telemetry` does it through the same core services (#220).
 *
 * ponytail: the collectors, the buffer, the payload merge and the samplers are excubia-core
 * classes that `docs/CONTRACTS.md` calls internal; ask the core for a public "collect, sample and
 * drain" API if they move.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:48;s:7:"endLine";i:287;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:3:{s:11:"CONFIG_PATH";a:12:{s:18:"declaringClassName";s:34:"App\Services\SelfMonitoringService";s:21:"implementingClassName";s:34:"App\Services\SelfMonitoringService";s:4:"name";s:11:"CONFIG_PATH";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:40:"'resources/excubia/self-monitoring.json'";s:10:"attributes";a:6:{s:9:"startLine";i:50;s:7:"endLine";i:50;s:13:"startTokenPos";i:150;s:12:"startFilePos";i:2301;s:11:"endTokenPos";i:150;s:10:"endFilePos";i:2340;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:5;s:9:"endColumn";i:72;}s:9:"ALL_TYPES";a:12:{s:18:"declaringClassName";s:34:"App\Services\SelfMonitoringService";s:21:"implementingClassName";s:34:"App\Services\SelfMonitoringService";s:4:"name";s:9:"ALL_TYPES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:5:"'all'";s:10:"attributes";a:6:{s:9:"startLine";i:53;s:7:"endLine";i:53;s:13:"startTokenPos";i:163;s:12:"startFilePos";i:2458;s:11:"endTokenPos";i:163;s:10:"endFilePos";i:2462;}}s:10:"docComment";s:80:"/** `EXCUBIA_SELF_MONITORING_TYPES` value that turns on every available type. */";s:10:"attributes";a:0:{}s:9:"startLine";i:53;s:7:"endLine";i:53;s:11:"startColumn";i:5;s:9:"endColumn";i:35;}s:20:"DEFAULT_SAMPLE_RATES";a:12:{s:18:"declaringClassName";s:34:"App\Services\SelfMonitoringService";s:21:"implementingClassName";s:34:"App\Services\SelfMonitoringService";s:4:"name";s:20:"DEFAULT_SAMPLE_RATES";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:16:"['cache' => 0.1]";s:10:"attributes";a:6:{s:9:"startLine";i:59;s:7:"endLine";i:59;s:13:"startTokenPos";i:176;s:12:"startFilePos";i:2715;s:11:"endTokenPos";i:182;s:10:"endFilePos";i:2730;}}s:10:"docComment";s:192:"/**

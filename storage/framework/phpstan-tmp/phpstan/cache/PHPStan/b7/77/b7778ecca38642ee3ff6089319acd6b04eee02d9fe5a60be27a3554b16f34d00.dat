O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-c9e731cf232727f5895ee8c0b6caa3fe5fdae02fb94c03cb996ef082fa204937-8.4.27-6.75.0.4";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:8:"filename";s:176:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/vendor/composer/../qiick/excubia-core/src/Data/ExcubiaConfigurationData.php";}}s:9:"namespace";s:18:"Qiick\Excubia\Data";s:4:"name";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:9:"shortName";s:24:"ExcubiaConfigurationData";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:65568;s:10:"docComment";s:2894:"/**
 * Knobs the checks and the cache read. The JSON loader fills this object.
 *
 * Defaults match the spec: fail on high, include dev dependencies, stale
 * after 24 months, warn 180 days before end of life, node check enabled,
 * cache TTL 24 hours. A null `failOnSeverity` is `--fail-on=none`.
 * A null `cacheDirectory` means the cache service chooses its own directory.
 * `appUrl` and `appToken` come from the `app` key and are read only by
 * `excubia push`; the token is never printed, cached or written to a report.
 * `isStrict` is the `strict` key: data-source failures exit 3 (`--strict`).
 * `isHealthEndpointEnabled` and `healthEndpointPath` are the `healthEndpoint`
 * keys read by the Laravel provider (`docs/health-endpoint.md`).
 * The posture thresholds default to a scheduler heartbeat older than 10
 * minutes and failed jobs older than 24 hours (high instead of medium).
 * The infrastructure thresholds default to a disk warning at 80 % used and
 * a failure at 90 %, and a queue backlog warning when the oldest pending job
 * waits 15 minutes or a queue holds 1000 pending jobs.
 * `databaseConnectionNames` are probed on top of the default connection;
 * `queueBacklogQueueNames` are read on top of the default queue (Redis only,
 * the database driver reads every queue in its table).
 * `runtime` is the opt-in runtime monitoring key (`RuntimeConfigurationData`),
 * `exceptions` the separate opt-in exception capture key (`ExceptionConfigurationData`).
 * `skippedPackagePatterns` is `privacy.skipPackages`: globs (`*`, `?`) of
 * package names that are never sent to a public data source, on top of the
 * packages the lockfile already marks private.
 * `release` is the `release` key as written; `ReleaseService` validates it
 * and falls back to the environment when it is null.
 * `dependencyLicenses` holds the `checks.dependency-licenses` keys and
 * `envExampleSync` the `checks.env-example-sync` keys.
 * `queueWorkersStaleAfterMinutes` is `checks.laravel-queue-workers.staleAfterMinutes`:
 * a queue with pending jobs warns when no worker heartbeat is newer (default 5).
 * `backupsMaxAgeHours` is `checks.laravel-backups.maxAgeHours`: a monitored
 * backup destination fails when its newest backup is older (default 26).
 * `databaseConnectionsWarnAt` and `databaseConnectionsFailAt` are
 * `checks.laravel-database-connections.warnAt` / `failAt` (open connections
 * above which the check warns or fails, default 50 and 100);
 * `databaseSizeWarnAtMb` is `checks.laravel-database-size.warnAtMb` (null,
 * the default, only reports the size).
 * `redisMemoryWarnAtPercentUsed` and `redisMemoryFailAtPercentUsed` are the
 * `checks.laravel-redis-memory` thresholds on the share of `maxmemory` used
 * (default 80 and 90); `redisMemoryConnectionNames`, when not empty, replaces
 * the Redis connections found through the cache, queue and session config.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:55;s:7:"endLine";i:417;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:28:"DEFAULT_HEALTH_ENDPOINT_PATH";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:21:"implementingClassName";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:4:"name";s:28:"DEFAULT_HEALTH_ENDPOINT_PATH";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:16:"'excubia/health'";s:10:"attributes";a:6:{s:9:"startLine";i:57;s:7:"endLine";i:57;s:13:"startTokenPos";i:55;s:12:"startFilePos";i:3195;s:11:"endTokenPos";i:55;s:10:"endFilePos";i:3210;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:57;s:7:"endLine";i:57;s:11:"startColumn";i:5;s:9:"endColumn";i:65;}s:22:"PACKAGE_PATTERN_SYNTAX";a:12:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:21:"implementingClassName";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:4:"name";s:22:"PACKAGE_PATTERN_SYNTAX";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:26:"'#^[A-Za-z0-9@/._~*?-]+$#'";s:10:"attributes";a:6:{s:9:"startLine";i:59;s:7:"endLine";i:59;s:13:"startTokenPos";i:66;s:12:"startFilePos";i:3257;s:11:"endTokenPos";i:66;s:10:"endFilePos";i:3282;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:59;s:7:"endLine";i:59;s:11:"startColumn";i:5;s:9:"endColumn";i:70;}}s:19:"immediateProperties";a:37:{s:14:"failOnSeverity";a:16:{s:18:"declaringClassName";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:21:"implementingClassName";s:43:"Qiick\Excubia\Data\ExcubiaConfigurationData";s:4:"name";s:14:"failOnSeverity";s:9:"modifiers";i:2049;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:32:"
O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.75.0.4-8.4.27-50a9ad17e7e25e649e9315238acce680aacfe6a04b8fcb487199b6d2356abcc1";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:32:"App\Services\ReportAlertsService";s:8:"filename";s:137:"/Users/lucagiardi/Projects/LucaGiardi/Qiick/Excubia/excubia-app/.claude/worktrees/287-project-avatar/app/Services/ReportAlertsService.php";}}s:9:"namespace";s:12:"App\Services";s:4:"name";s:32:"App\Services\ReportAlertsService";s:9:"shortName";s:19:"ReportAlertsService";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:1357:"/**
 * The alerts a new report raises (#22), from what it changed in the finding lifecycle (#18):
 * findings that opened or came back (`finding.new`), findings resolved because their check ran
 * without them (`finding.resolved`), a worse or better worst severity of the open findings, and
 * a stale project reporting again. A push with fewer checks (standalone CLI, `--only`) resolves
 * nothing and so neither flaps `finding.resolved` / `finding.new` nor `project.recovered` /
 * `project.worsened`. Dismissed findings raise no finding alerts and leave the worst severity.
 * The first report of a project raises no finding alerts (everything would be "new"), except
 * `infrastructure.failed` (#109): a database, storage or disk failure that is new or back, or on
 * the first report, alerts at once at critical, instead of as `finding.new`, unless a
 * `health.failed` of the same check and fingerprint just went out (#143). A check whose data
 * source failed in this report and not in the previous one raises `report.checks_skipped`.
 * The end-of-life alerts of the report's runtimes (#157) follow, also on the first report.
 * All of a report's alerts go out as one message per Slack, Telegram and email channel.
 * A finding alert of an assigned finding (#254) names the assignee in its summary and data, so
 * the channel tells who is on it.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:158;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:14:"FINDINGS_LIMIT";a:12:{s:18:"declaringClassName";s:32:"App\Services\ReportAlertsService";s:21:"implementingClassName";s:32:"App\Services\ReportAlertsService";s:4:"name";s:14:"FINDINGS_LIMIT";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:2:"20";s:10:"attributes";a:6:{s:9:"startLine";i:35;s:7:"endLine";i:35;s:13:"startTokenPos";i:68;s:12:"startFilePos";i:1773;s:11:"endTokenPos";i:68;s:10:"endFilePos";i:1774;}}s:10:"docComment";s:88:"/** Finding alerts per report and kind, so a big upgrade does not flood the channels. */";s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:5;s:9:"endColumn";i:37;}}s:19:"immediateProperties";a:3:{s:6:"alerts";a:16:{s:18:"declaringClassName";s:32:"App\Services\ReportAlertsService";s:21:"implementingClassName";s:32:"App\Services\ReportAlertsService";s:4:"name";s:6:"alerts";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"App\Services\AlertDispatcherService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:38;s:7:"endLine";i:38;s:11:"startColumn";i:9;s:9:"endColumn";i:46;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"findings";a:16:{s:18:"declaringClassName";s:32:"App\Services\ReportAlertsService";s:21:"implementingClassName";s:32:"App\Services\ReportAlertsService";s:4:"name";s:8:"findings";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:34:"App\Services\ReportFindingsService";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attribut
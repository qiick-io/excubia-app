 * Opt-in exception capture (`docs/exception-schema.json`, SPEC sections 7
 * and 13, D17).
 *
 * Registers one `reportable()` callback on Laravel's exception handler (or
 * on a decorator that forwards `reportable()`, like Collision's). The
 * callback returns nothing, so the host app's own reporting (its other
 * callbacks, its log channels, Sentry, Flare…) runs exactly as before, and
 * it only sees what the app reports: `dontReport` and `ShouldntReport`
 * still apply. Each occurrence is masked (`ExceptionPayloadService`),
 * grouped in memory by fingerprint, context and environment, and written to
 * the buffer `storage/excubia/exceptions/` when the request or command
 * terminates, when a queue worker loops, or once MAX_PENDING_GROUPS groups
 * are pending. Nothing is sent from here: `excubia:push-runtime` sends it.
 *
 * Context: the job class (from `JobExceptionOccurred` / `JobFailed`, keyed
 * by the exception), else the matched route name, else the running Artisan
 * command name (or the last one that exited non-zero: the console kernel
 * reports an uncaught command exception after `CommandFinished`), else
 * `unknown`. Laravel fires the command events outside unit tests only.
 *
 * Every step swallows its own exceptions: capture never reaches the host
 * application and never stops its reporting.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:47;s:7:"endLine";i:261;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:18:"MAX_PENDING_GROUPS";a:12:{s:18:"declaringClassName";s:47:"Qiick\Excubia\Laravel\ExceptionCollectorService";s:21:"implementingClassName";s:47:"Qiick\Excubia\Laravel\ExceptionCollectorService";s:4:"name";s:18:"MAX_PENDING_GROUPS";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"100";s:10:"attributes";a:6:{s:9:"startLine";i:49;s:7:"endLine";i:49;s:13:"startTokenPos";i:108;s:12:"startFilePos";i:2048;s:11:"endTokenPos";i:108;s:10:"endFilePos";i:2050;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:49;s:7:"endLine";i:49;s:11:"startColumn";i:5;s:9:"endColumn";i:42;}}s:19:"immediateProperties";a:9:{s:6:"groups";a:16:{s:18:"declaringClassName";s:47:"Qiick\Excubia\Laravel\ExceptionCollectorService";s:21:"implementingClassName";s:47:"Qiick\Excubia\Laravel\ExceptionCollectorService";s:4:"name";s:6:"groups";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default";a:2:{s:4:"code";s:2:"[]";s:10:"attributes";a:6:{s:9:"startLine";i:52;s:7:"endLine";i:52;s:13:"startTokenPos";i:121;s:12:"startFilePos";i:2134;s:11:"endTokenPos";i:122;s:10:"endFilePos";i:2135;}}s:10:"docComment";s:47:"/** @var array<string, array<string, mixed>> */";s:10:"attributes";a:0:{}s:9:"startLine";i:52;s:7:"endLine";i:52;s:11:"startColumn";i:5;s:9:"endColumn";i:31;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"jobNames";a:16:{s:18:"declaringClassName";s:47:"Qiick\Excubia\Laravel\ExceptionCollectorService";s:21:"implementingClassName";s:47:"Qiick\Excubia\Laravel\ExceptionCollectorService";s:4:"name";s:8:"jobNames";s:9:"modifiers";i:4;s:4:"type";a:2: